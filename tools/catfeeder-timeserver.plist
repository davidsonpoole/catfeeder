<?xml version="1.0" encoding="UTF-8"?>
<!-- Answers the feeder's requests for the time.

     The feeder has no clock of its own and will not feed until it has been
     told the time, so it asks the network on startup and every 30 seconds
     until someone answers. This agent is what answers.

     Install:
       cp tools/catfeeder-timeserver.plist ~/Library/LaunchAgents/local.catfeeder.timeserver.plist
       # edit the path below to match this checkout, then:
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/local.catfeeder.timeserver.plist

     KeepAlive, because the point of it is to be there when the feeder comes
     back from a power cut. macOS may ask once whether python3 can accept
     incoming connections; it needs to, to hear the feeder's broadcast. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.catfeeder.timeserver</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/davidson/git/self/catfeeder/tools/catfeeder</string>
        <string>serve-time</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/catfeeder-timeserver.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/catfeeder-timeserver.log</string>
</dict>
</plist>
